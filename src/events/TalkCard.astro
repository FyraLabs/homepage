---
import { Icon } from "astro-icon/components";
import type { Talk } from "./types";

type Props = Talk;

const { title, description, speakers, time, location, link } = Astro.props;
---

<article
  class="flex flex-col gap-3 p-6 bg-neutral-100 dark:bg-neutral-800 hover:shadow-md transition-all rounded-2xl"
>
  <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-gray-600 dark:text-gray-300">
    <span class="flex items-center gap-1.5">
      <Icon name="fa-solid:clock" class="text-violet-700 dark:text-violet-300" />
      {time}
    </span>
    <span class="flex items-center gap-1.5">
      <Icon name="fa-solid:map-marker-alt" class="text-violet-700 dark:text-violet-300" />
      {location}
    </span>
  </div>

  <h2 class="font-bold text-2xl dark:opacity-92">
    {
      link ? (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 hover:text-violet-700 dark:hover:text-violet-300 transition-all"
        >
          {title}
          <Icon
            name="fa-solid:arrow-right"
            class="text-lg opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
          />
        </a>
      ) : (
        title
      )
    }
  </h2>

  <p class="text-gray-800 dark:text-gray-300">{description}</p>

  <p class="mt-auto flex items-center gap-2 pt-2 text-sm font-medium dark:opacity-92">
    <Icon name="fa-solid:user" class="text-violet-700 dark:text-violet-300" />
    <span>
      <span class="text-gray-600 dark:text-gray-300 font-normal">With</span>
      {" "}{speakers.join(", ")}
    </span>
  </p>
</article>
